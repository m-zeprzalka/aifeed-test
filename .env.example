# ============================================
# AiFeed — Zmienne Środowiskowe
# Skopiuj do .env.local i uzupełnij wartości
# ============================================

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenRouter API (generowanie artykułów) ---
# Klucz: https://openrouter.ai/keys
# Model: anthropic/claude-sonnet-4 (konfiguracja w src/lib/ai/writer.ts)
OPENROUTER_API_KEY=sk-or-v1-...

# --- Ochrona endpointów ---
# Dowolny string chroniący /api/cron/generate (fail-closed: brak = 401)
CRON_SECRET=your-random-secret-here

# --- URL serwisu ---
# Używany w SEO, sitemap, RSS feed, metadanych Open Graph.
# Dla produkcji: pełny URL bez końcowego slasha, zgodny z wariantem www/non-www
# który serwuje ruch (aktualnie: https://www.aifeed.pl).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dashboard /admin (Basic Auth) ---
# Bez tych zmiennych /admin zwraca 503 (lepiej niż otwarty dostęp).
# Username dowolny (ASCII), hasło długie i losowe (`openssl rand -base64 24`;
# ASCII — Basic Auth dekoduje latin-1, polskie znaki nie przejdą). To JEDYNA
# warstwa autoryzacji dashboardu i akcji admina.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# --- Google Analytics (opcjonalne) ---
# GA renderuje się tylko gdy zmienna jest ustawiona. Na Vercelu ustawiona
# WYŁĄCZNIE w Production — preview/dev nie zaśmiecają produkcyjnego property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
